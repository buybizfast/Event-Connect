rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write access to all users for development purposes
    // WARNING: This is insecure and should be properly restricted in production
    match /{allPaths=**} {
      allow read, write: if true;
    }
    
    // More secure rules for production (commented out for now)
    /*
    match /{allPaths=**} {
      allow read: if true;  // Allow anyone to read files
      allow write: if request.auth != null;  // Only authenticated users can write
    }
    
    // User profile images
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Event images
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    */
  }
} 